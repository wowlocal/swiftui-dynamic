<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Foreground variant of IceCubesCheck-Info.plist for the interactive
       `--run` window. The capture harness plist declares LSUIElement, which
       keeps a Catalyst scene in a background state whose display link never
       starts: window chrome appears but the UIKit content layer never
       composites (offscreen drawHierarchy is unaffected, so the R2 board
       never noticed). An interactive window must be a regular app. -->
  <key>CFBundleExecutable</key><string>IceCubesCheck</string>
  <key>CFBundleIdentifier</key><string>dev.swiftuidynamic.IceCubesRun</string>
  <key>CFBundleName</key><string>IceCubesRun</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>UIDeviceFamily</key><array><integer>2</integer></array>
</dict>
</plist>
